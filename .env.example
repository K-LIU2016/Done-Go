# Copy to .env locally and supply your provider credential. Never commit .env.
TANGO_AI_PROVIDER=openai
TANGO_AI_URL=https://api.openai-next.com/v1/chat/completions
TANGO_AI_MODEL=gpt-6.1-sol
TANGO_AI_REASONING_EFFORT=xhigh
TANGO_AI_KEY=
TANGO_DEMO_MODE=0
# Optional per-purpose model overrides; omit to use TANGO_AI_MODEL for all.
# TANGO_AI_MODEL_HEAVY=gpt-6.1-sol
# TANGO_AI_MODEL_STANDARD=gpt-6.1-sol
# TANGO_AI_MODEL_LIGHT=gpt-6.1-sol

# Email registration. Supply sender credentials on the server only.
# EMAIL_TRANSPORT=resend
# RESEND_API_KEY=
# MAIL_FROM=DoneGo <verify@your-verified-domain.example>
# SMTP alternative: EMAIL_TRANSPORT=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# NODE_ENV=production
# TANGO_PUBLIC_ORIGIN=https://your-domain.example
# TANGO_AUTH_SECRET=replace-with-a-persistent-random-secret-of-at-least-32-bytes
# TANGO_COLLAB_DB=/app/.tango-donego/collaboration.sqlite
ADMIN_EMAILS=yajing1906232977@163.com
