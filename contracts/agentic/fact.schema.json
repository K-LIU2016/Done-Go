{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "ownerId",
    "subject",
    "predicate",
    "object",
    "source",
    "confidence",
    "learnedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ownerId": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "object": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validTo": {
      "type": "string",
      "format": "date-time"
    },
    "learnedAt": {
      "type": "string",
      "format": "date-time"
    },
    "supersededAt": {
      "type": "string",
      "format": "date-time"
    },
    "confirmed": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "description": "可见、可改、可删的双时态用户事实。PRD §7.3。",
  "$id": "fact.schema.json",
  "title": "Fact"
}
