{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "ownerId",
    "revision",
    "schemaVersion",
    "createdAt",
    "updatedAt",
    "deletedAt",
    "source",
    "contractHash",
    "actor",
    "capabilities",
    "dataDisclosure",
    "expiresAt",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ownerId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "real",
        "demo",
        "imported"
      ]
    },
    "contractHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "dataDisclosure": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "consumed",
        "revoked",
        "expired",
        "invalidated"
      ]
    },
    "consumedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "description": "有限能力授权。PRD §4.1、§8.4。",
  "$id": "grant.schema.json",
  "title": "Grant"
}
