{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "ownerId",
    "missionId",
    "version",
    "type",
    "status",
    "title",
    "location",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ownerId": {
      "type": "string",
      "minLength": 1
    },
    "missionId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "report",
        "document",
        "slides",
        "code-diff",
        "checklist",
        "route-card",
        "brief",
        "message-draft",
        "artifact",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "generating",
        "ready",
        "accepted",
        "revision_requested",
        "rejected"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "description": "版本化交付物。PRD §4.1、§5.6。",
  "$id": "artifact.schema.json",
  "title": "Artifact"
}
