{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "runId",
    "name",
    "kind",
    "state",
    "attempt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "parentStepId": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "plan",
        "schedule",
        "execute",
        "verify",
        "merge"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "paused",
        "skipped"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checkpoint": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "description": "运行时最小可观测单元与检查点。PRD §6.3。",
  "$id": "step.schema.json",
  "title": "Step"
}
