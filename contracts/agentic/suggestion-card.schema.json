{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "blockId",
    "text",
    "actions",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "blockId": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "remember",
              "todo",
              "adjust",
              "remind",
              "delegate"
            ]
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "instant",
        "upgraded",
        "dismissed",
        "applied"
      ]
    }
  },
  "additionalProperties": false,
  "description": "快慢双路感知生成的建议卡。PRD §6.8.2。",
  "$id": "suggestion-card.schema.json",
  "title": "SuggestionCard"
}
