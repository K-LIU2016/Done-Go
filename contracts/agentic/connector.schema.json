{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "ownerId",
    "revision",
    "schemaVersion",
    "createdAt",
    "updatedAt",
    "deletedAt",
    "source",
    "name",
    "transport",
    "reads",
    "writes",
    "risk",
    "processing",
    "retention"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ownerId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "real",
        "demo",
        "imported"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "transport": {
      "type": "string",
      "enum": [
        "mcp-http",
        "mcp-stdio(bridge)"
      ]
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scope",
          "dataClass",
          "freshness"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "dataClass": {
            "type": "string",
            "enum": [
              "public",
              "personal",
              "sensitive",
              "secret"
            ]
          },
          "freshness": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "writes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "quota": {
      "type": "object",
      "properties": {
        "perDay": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "processing": {
      "type": "string",
      "enum": [
        "local",
        "cloud"
      ]
    },
    "retention": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "description": "MCP 插件能力清单。PRD §7.1。",
  "$id": "connector.schema.json",
  "title": "Connector"
}
