{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "missionId",
    "version",
    "classification",
    "confidence",
    "resources",
    "missing",
    "feasibility",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "missionId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "classification": {
      "type": "string",
      "enum": [
        "D1",
        "D2",
        "D3",
        "D4",
        "R1",
        "R2",
        "R3",
        "R4",
        "S",
        "M"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "needs_authorization",
              "needs_user",
              "unavailable"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "feasibility": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "infeasible"
      ]
    },
    "reason": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "description": "Mission 的版本化扫描快照。PRD §4.1、§11.2。",
  "$id": "scan.schema.json",
  "title": "Scan"
}
