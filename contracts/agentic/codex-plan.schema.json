{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "missionId",
    "model",
    "effort",
    "files",
    "steps",
    "risks",
    "tests"
  ],
  "properties": {
    "missionId": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "enum": [
        "gpt-6-luna",
        "gpt-6-sol",
        "gpt-6.1-sol"
      ]
    },
    "effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diffLines": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "description": "Codex 只读规划输出。PRD §6.5。",
  "$id": "codex-plan.schema.json",
  "title": "CodexPlan"
}
